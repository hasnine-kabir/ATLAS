# ATLAS Voice Assistant Environment Variables
# Copy this file to .env and customize. Never commit .env to version control.

# Google Gemini API Key for LLM fallback and natural language understanding
GEMINI_API_KEY=your_gemini_api_key_here

# User greeting preferences
ATLAS_USER_NAME=Hasnine
ATLAS_ADDRESS_AS=Hasnine

# Audio device overrides (leave blank for system defaults)
ATLAS_INPUT_DEVICE=
ATLAS_OUTPUT_DEVICE=

# Logging level (DEBUG, INFO, WARNING, ERROR)
ATLAS_LOG_LEVEL=INFO
